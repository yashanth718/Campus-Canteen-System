# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
TIMEZONE=Asia/Kolkata
CANTEEN_NAME="Campus Cloud Canteen"

# Firebase Admin Service Account Credentials
# (Obtained from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-id.firebaseio.com

# Razorpay Test Mode Credentials (Optional)
# (Obtained from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret
