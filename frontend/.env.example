# Backend API URL (Use Cloud Run URL in production, localhost in development)
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web App Configuration
# (Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyExample
VITE_FIREBASE_AUTH_DOMAIN=campus-canteen-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campus-canteen-demo
VITE_FIREBASE_STORAGE_BUCKET=campus-canteen-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=10987654321
VITE_FIREBASE_APP_ID=1:10987654321:web:a1b2c3d4e5f6g7h8
VITE_FIREBASE_VAPID_KEY=BF_YourWebPushVapidKeyHereExample

# College Canteen Branding
VITE_APP_TITLE="Campus Cloud Canteen"
